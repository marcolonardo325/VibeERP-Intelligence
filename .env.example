# D365 Finance & Operations — Azure AD App Registration
# Copy this file to .env and fill in your values
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
D365_URL=https://your-environment.operations.dynamics.com

# TfL Live Map Server
# TfL API key (optional – register free at https://api-portal.tfl.gov.uk)
TFL_APP_KEY=

# Microsoft Graph API – for work-order email (optional)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-graph-client-id
GRAPH_CLIENT_SECRET=your-graph-client-secret
GRAPH_SENDER_EMAIL=your-sender@yourdomain.onmicrosoft.com
